    // CLASSE ABSTRATA USUARIO
    // =========================================================
    public abstract class Usuario
    {
        // ATRIBUTOS
        protected int idUsuario;
        protected string nome;
        protected string email;
        protected string senha;

        // PROPRIEDADES
        public int IdUsuario
        {
            get { return idUsuario; }
            set { idUsuario = value; }
        }

        public string Nome
        {
            get { return nome; }
            set { nome = value; }
        }

        public string Email
        {
            get { return email; }
            set { email = value; }
        }

        public string Senha
        {
            get { return senha; }
            set { senha = value; }
        }

        // MÉTODOS
        public virtual void Login()
        {
            Console.WriteLine("Usuário logado.");
        }

        public virtual void Logout()
        {
            Console.WriteLine("Usuário deslogado.");
        }

        public virtual void EditarPerfil()
        {
            Console.WriteLine("Perfil atualizado.");
        }
    }

    // =========================================================
    // CLASSE ALUNO (HERDA DE USUARIO)
    // =========================================================
    public class Aluno : Usuario
    {
        private DateTime dataNascimento;
        private int xpTotalAluno;

        // RELACIONAMENTOS
        public List<Matricula> Matriculas { get; set; }
        public List<Resposta> Respostas { get; set; }

        // CONSTRUTOR
        public Aluno()
        {
            Matriculas = new List<Matricula>();
            Respostas = new List<Resposta>();
        }

        // PROPRIEDADES
        public DateTime DataNascimento
        {
            get { return dataNascimento; }
            set { dataNascimento = value; }
        }

        public int XpTotalAluno
        {
            get { return xpTotalAluno; }
            set { xpTotalAluno = value; }
        }

        // MÉTODOS
        public void MatricularSe()
        {
            Console.WriteLine("Aluno matriculado.");
        }

        public void ResponderQuestionario()
        {
            Console.WriteLine("Questionário respondido.");
        }

        public void VisualizarProgresso()
        {
            Console.WriteLine("Visualizando progresso.");
        }

        public void ReceberXP()
        {
            Console.WriteLine("XP recebido.");
        }
    }

